SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///farm_marketplace.db

# Email (Outlook primary, Gmail backup)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your-email@outlook.com
MAIL_PASSWORD=your-outlook-app-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEBUG=false

MAIL_BACKUP_SERVER=smtp.gmail.com
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=your-email@gmail.com
MAIL_BACKUP_PASSWORD=your-gmail-app-password
MAIL_BACKUP_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_BACKUP_USE_TLS=true
MAIL_BACKUP_USE_SSL=false

# Optional deployment settings
FLASK_ENV=production
SERVER_NAME=yourdomain.com
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=cad
STRIPE_MONTHLY_AMOUNT_CENTS=3000
STRIPE_YEARLY_AMOUNT_CENTS=30000
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
ALERT_WEBHOOK_URL=
ALERT_EMAIL=
ALERT_COOLDOWN_SECONDS=300
SESSION_COOKIE_SECURE=false
